# =========================================================
# Salin file ini menjadi .env (untuk lokal) atau isi lewat
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# JANGAN commit file .env yang sudah berisi value asli ke Git.
# =========================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key_supabase

# --- Admin panel ---
# Password yang diketik HR di halaman admin-login.html
ADMIN_PASSWORD=ganti_dengan_password_kuat
# Token internal (bebas, string acak panjang) — dipakai sebagai session token
# setelah login berhasil. Buat sendiri, misalnya lewat: openssl rand -hex 32
ADMIN_API_TOKEN=ganti_dengan_random_string_panjang

# --- Groq AI Router (simulasi customer komplain) ---
# Isi 1 sampai 6 key. Kalau key-1 gagal/limit, router otomatis coba key-2, dst.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# --- Konfigurasi durasi test (opsional, default sudah ada di kode) ---
# Bagian pengetahuan sekarang 18 pilihan ganda + 8 tes fokus + 6 esai (32 soal).
KNOWLEDGE_TIME_LIMIT_MINUTES=15
COMPLAINT_TIME_LIMIT_MINUTES=10
MAX_COMPLAINT_EXCHANGES=5
